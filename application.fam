App(
    appid="miles_tag_ii",
    name="MilesTag II TX",
    apptype=FlipperAppType.EXTERNAL,
    entry_point="miles_tag_ii_app",
    requires=["gui", "notification"],
    stack_size=4 * 1024,
    fap_category="Infrared",
    fap_icon="images/miles_tag_ii_10px.png",
    fap_icon_assets="images",
    fap_description="Transmit any MilesTag II laser tag IR signal: shots (player/team/damage), health/ammo grants, admin commands and pickups, on a 38/40/56 kHz carrier.",
    fap_author="nerfbilly64",
    fap_version="1.0",
    # Listed one by one on purpose: the default "*.c*" glob is recursive and
    # would try to compile the Arduino reference library in milesTagArduino/.
    sources=[
        "miles_tag_ii.c",
        "miles_tag_log.c",
        "miles_tag_protocol.c",
        "miles_tag_settings.c",
        "miles_tag_tx.c",
        "scenes/miles_tag_scenes.c",
        "scenes/miles_tag_scene_menu.c",
        "scenes/miles_tag_scene_config.c",
        "scenes/miles_tag_scene_player.c",
        "scenes/miles_tag_scene_command.c",
        "scenes/miles_tag_scene_data.c",
        "scenes/miles_tag_scene_tx.c",
        "scenes/miles_tag_scene_sweep_config.c",
        "scenes/miles_tag_scene_sweep_run.c",
        "scenes/miles_tag_scene_about.c",
        "views/miles_tag_tx_view.c",
        "views/miles_tag_sweep_view.c",
    ],
)
